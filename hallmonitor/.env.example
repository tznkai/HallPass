# Environment template for hallmonitor: each variable is described where it is set below.

# Hallpass monitor listener. The token must match HALLPASS_MONITOR_TOKEN in hallpass (32 characters or more).
# A plain http:// URL sends the bearer token unencrypted. Use one only on a private network, or through a tunnel that
# only hallmonitor and hallpass share; prefer a loopback address (127.0.0.1) through such a tunnel. https:// encrypts it.
HALLPASS_MONITOR_URL=
HALLPASS_MONITOR_TOKEN=

# Local state (the own-suspension record) and the reconcile interval in seconds (at least 10).
HALLMONITOR_DATA_DIR=data
HALLMONITOR_INTERVAL_SECONDS=60
HALLMONITOR_LOG_LEVEL=INFO

# Fluxer admin API base, before /v1, and its admin key. Both or neither.
FLUXER_ADMIN_URL=
FLUXER_ADMIN_KEY=

# Per-service settings: HM_SERVICE_<SLUG>__<KEY>. Blank values are ignored.
# Fluxer's SSO provider id. Read it from GET /v1/admin/users/{id}/sso-identities on any account that has signed
# in through SSO; the provider_id field is the value.
HM_SERVICE_FLUXER__SSO_PROVIDER_ID=
# Minecraft over RCON: set the host and the RCON password together. The port defaults to 25575.
# HM_SERVICE_MINECRAFT__HOST=
# HM_SERVICE_MINECRAFT__PORT=25575
# HM_SERVICE_MINECRAFT__RCON_PASSWORD=
# HM_SERVICE_MINECRAFT__FLOODGATE_PREFIX=.
# Palworld over its REST API, with the ban list read through Pterodactyl. Every setting is needed, or the service has no
# adapter. The Pterodactyl key is a subuser's Client API key; Palworld only reads its ban list, so the subuser needs
# file.read and file.read-content on that server and nothing else.
# HM_SERVICE_PALWORLD__REST_URL=
# HM_SERVICE_PALWORLD__ADMIN_PASSWORD=
# HM_SERVICE_PALWORLD__PTERO_URL=
# HM_SERVICE_PALWORLD__PTERO_KEY=
# HM_SERVICE_PALWORLD__PTERO_SERVER=
# HM_SERVICE_PALWORLD__BANLIST_PATH=
# Optional: how long after a ban, in seconds, a ban the list does not show yet still counts as in flight (default 600,
# a positive whole number). After that window an unlisted ban is forgotten.
# HM_SERVICE_PALWORLD__FORGET_GRACE_SECONDS=600
# Valheim through its permittedlist.txt, read and written through Pterodactyl. A subject is allowed while an entry names
# its SteamID64, bare, as Steam_<id> or as V_<id>. A suspension removes every line of the id in any of those forms, and
# never leaves the list empty. A restore writes V_<id>, which keeps working when crossplay is turned on later.
# PERMITTEDLIST_PATH is the file hallmonitor edits. BANNEDLIST_PATH is optional and read only: an id on the ban list is
# reported banned_external and is never changed. Each of the four required settings is needed, or the service has no
# adapter. The old BANLIST_PATH setting is no longer read.
# live_reload is true only when the live check showed the server applies the file without a restart; then a removal
# disconnects a player who is online. The default false reports a change as pending until a restart.
# The subuser needs file.read, file.read-content and file.create on that server: the write route checks file.create,
# not file.update.
# HM_SERVICE_VALHEIM__PTERO_URL=
# HM_SERVICE_VALHEIM__PTERO_KEY=
# HM_SERVICE_VALHEIM__PTERO_SERVER=
# HM_SERVICE_VALHEIM__PERMITTEDLIST_PATH=
# HM_SERVICE_VALHEIM__BANNEDLIST_PATH=
# HM_SERVICE_VALHEIM__LIVE_RELOAD=false
# The Ship over Source RCON, with the bans and the list read through the console. THE_SHIP stands for the hallpass
# service SLUG written in upper case, with each `-` as `_`: the slug `the-ship` gives HM_SERVICE_THE_SHIP__HOST.
# A slug is lower-case letters and digits with single hyphens only between them, up to 64 characters, so a doubled or
# trailing hyphen has no variable name here.
# Every setting but the port and universe is needed, or the service has no adapter. The universe digit is the one the
# server prints in its STEAM_<n>:<y>:<z> ids, 0 by default.
# HM_SERVICE_THE_SHIP__HOST=
# HM_SERVICE_THE_SHIP__PORT=27015
# HM_SERVICE_THE_SHIP__RCON_PASSWORD=
# HM_SERVICE_THE_SHIP__STEAMID_UNIVERSE=0
