#
# Hallpass configuration template. Copy it to .env and fill in the empty secrets. The program reads only the
# process environment; the operator sources the file in the shell. Lines starting with # are comments.

# Required: the public https origin of hallpass, with no trailing slash.
HALLPASS_PUBLIC_URL=https://hallpass.invalid
# Required: signs the session cookie. At least 32 characters. Secret.
HALLPASS_SESSION_SECRET=
# Optional: cookie domain, for sharing the session with a sibling host such as .hallpass.invalid.
HALLPASS_COOKIE_DOMAIN=
# Optional, default 43200: session lifetime in seconds.
HALLPASS_SESSION_MAX_AGE_SECONDS=43200
# Optional, default data: directory for the SQLite database.
HALLPASS_DATA_DIR=data
# Optional, default 127.0.0.1:8080: address the web server listens on.
HALLPASS_BIND=127.0.0.1:8080
# Optional: comma-separated Authentik user uuids of the administrators.
HALLPASS_ADMIN_SUBS=
# Optional, default 168: how long an invitation link stays valid, in hours.
HALLPASS_INVITE_EXPIRY_HOURS=168
# Optional, default INFO: one of DEBUG, INFO, WARNING, ERROR, CRITICAL.
HALLPASS_LOG_LEVEL=INFO

# Required: base URL of the Authentik server. https:// is required; http:// is accepted only for 127.0.0.1, ::1 or
# localhost, for local development.
AUTHENTIK_URL=https://authentik.invalid
# Required: Authentik API token for the service account that creates invitations and users. Secret.
AUTHENTIK_TOKEN=
# Required: slug of the Authentik flow that invitations use.
AUTHENTIK_INVITE_FLOW=hallpass-invite

# Required: the OpenID configuration URL of the Authentik provider for hallpass. The same https-only rule applies as
# for AUTHENTIK_URL: http:// is accepted only for 127.0.0.1, ::1 or localhost.
OIDC_METADATA_URL=https://authentik.invalid/application/o/hallpass/.well-known/openid-configuration
# Required: OIDC client id of the hallpass provider.
OIDC_CLIENT_ID=
# Required: OIDC client secret of the hallpass provider. Secret.
OIDC_CLIENT_SECRET=

# Optional: SMTP server for notification email. With no SMTP_HOST, mail stays queued and nothing is sent. When
# SMTP_HOST is set, SMTP_FROM is required.
SMTP_HOST=
# Optional, default 587: SMTP server port, from 1 to 65535.
SMTP_PORT=587
# Optional: SMTP login name.
SMTP_USERNAME=
# Optional: SMTP password. Secret.
SMTP_PASSWORD=
# Optional: the From address of notification email.
SMTP_FROM=hallpass@hallpass.invalid
# Optional, default true: upgrade the SMTP connection with STARTTLS. Set false only for a local test server.
SMTP_STARTTLS=true
# Optional: email address of the administrator, copied on lockdown notices.
HALLPASS_ADMIN_EMAIL=
# Optional, default 24: hours within which a second reversal by another parent locks a child down.
HALLPASS_CONFLICT_WINDOW_HOURS=24
